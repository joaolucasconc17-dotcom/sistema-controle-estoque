# ---------------------------------------------------------------------------
# Infraestrutura (docker-compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=estoque
POSTGRES_PASSWORD=estoque_dev_pwd
# 5433, nao 5432: neste ambiente ja existe um Postgres nativo do Windows
# ouvindo em 5432. Ajuste se sua maquina nao tiver esse conflito.
POSTGRES_PORT=5433
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Control plane: o banco que guarda o catalogo de empresas
# ---------------------------------------------------------------------------
CONTROL_DB_NAME=estoque_control
CONTROL_DATABASE_URL=postgresql://estoque:estoque_dev_pwd@localhost:5433/estoque_control

# Servidor Postgres onde os bancos das empresas sao criados.
# Aponta para o mesmo cluster em dev; em producao pode ser outro host/cluster.
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5433
TENANT_DB_USER=estoque
TENANT_DB_PASSWORD=estoque_dev_pwd

# ---------------------------------------------------------------------------
# Seguranca
# ---------------------------------------------------------------------------
# Chave de 32 bytes em hex (64 caracteres) usada para cifrar as connection
# strings dos tenants em repouso. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATASOURCE_ENCRYPTION_KEY=

# Segredos JWT. Gere cada um com o mesmo comando acima.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Quantos PrismaClient de tenant ficam quentes em memoria ao mesmo tempo.
# Cada um mantem seu proprio pool de conexoes contra o Postgres.
TENANT_POOL_MAX_CLIENTS=50
TENANT_POOL_IDLE_MS=300000
TENANT_CONNECTION_LIMIT=5
