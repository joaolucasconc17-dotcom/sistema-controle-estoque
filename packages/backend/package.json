{
  "name": "@estoque/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --schema prisma/control/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "control:generate": "prisma generate --schema prisma/control/schema.prisma",
    "control:migrate": "prisma migrate deploy --schema prisma/control/schema.prisma",
    "control:migrate:dev": "prisma migrate dev --schema prisma/control/schema.prisma",
    "tenant:generate": "prisma generate --schema prisma/tenant/schema.prisma",
    "tenant:migrate:dev": "prisma migrate dev --schema prisma/tenant/schema.prisma",
    "migrate:tenants": "tsx src/platform/migrations/runTenantMigrations.ts",
    "provision:tenant": "tsx src/platform/tenant/provisionTenant.ts"
  },
  "dependencies": {
    "@estoque/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.28.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
